# The CrazyGames build (npm run build:crazygames -w apps/web): see docs/CRAZYGAMES.md.
# The game files live on CrazyGames; accounts, tables and chat stay on the Heist server.
VITE_SERVER_URL=https://playheist.net
# 1 turns on a midgame ad between games (at most one every 3 minutes). Off: Heist sells nothing.
VITE_CG_MIDGAME_ADS=0
